# Copy to .env.local (gitignored). Identifiers only: a browser app holds no secret.
#
# local: the dev token issuer (make token), for `make api` on this machine. A build
#        for any other environment must say entra; the API there refuses dev tokens.
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# entra only: app-cloudops-web's client id, the directory, and the API's scope.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_API_SCOPE=api://cloudops-api-dev/access_as_user
