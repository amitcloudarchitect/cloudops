# Copy to .env.local (gitignored). Identifiers only: a browser app holds no secret.
#
# Built into the bundle: the sign-in mode. local is the dev token issuer (make token),
# for `make api` on this machine; a build for any other environment says entra, and
# the API there refuses dev tokens.
NEXT_PUBLIC_AUTH_MODE=local
# Read by the server at request time (ADR 0017); in a cluster, from the pod.
CLOUDOPS_WEB_API_BASE=http://127.0.0.1:8000
# entra only: app-cloudops-web's client id, the directory, and the API's scope.
CLOUDOPS_WEB_ENTRA_CLIENT_ID=
CLOUDOPS_WEB_ENTRA_TENANT_ID=
CLOUDOPS_WEB_API_SCOPE=
