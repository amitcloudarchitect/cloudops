CLOUDOPS_ENV=azure
CLOUDOPS_SECRETS_DIR=/mnt/secrets
CLOUDOPS_TEMPORAL_ADDRESS=temporal-frontend.temporal.svc.cluster.local:7233
CLOUDOPS_TEMPORAL_NAMESPACE=default
# The Certificate in connector-azure.yaml.
CLOUDOPS_TEMPORAL_TLS_DIR=/mnt/temporal-tls
# The connector's own bronze container (stack 04, `azure`).
CLOUDOPS_BRONZE_CONTAINER_URL=SET-IN-OVERLAY
CLOUDOPS_REPORTS_CONTAINER_URL=SET-IN-OVERLAY
# The platform's own Cost Management exports (ADR 0023): the account's blob endpoint
# and the roots in it, <container>/<root folder>/<export name>, comma-separated. Not
# secret; read with the workload identity's Entra token.
CLOUDOPS_AZURE_COST_EXPORT_ACCOUNT_URL=SET-IN-OVERLAY
CLOUDOPS_AZURE_COST_EXPORT_ROOTS=SET-IN-OVERLAY
# Telemetry (step 19, ADR 0022): OTLP to the in-cluster collector.
CLOUDOPS_TELEMETRY=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
CLOUDOPS_DEPLOYMENT=SET-IN-OVERLAY
