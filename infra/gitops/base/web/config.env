CLOUDOPS_WEB_ENTRA_CLIENT_ID=SET-IN-OVERLAY
CLOUDOPS_WEB_ENTRA_TENANT_ID=SET-IN-OVERLAY
CLOUDOPS_WEB_API_SCOPE=SET-IN-OVERLAY
