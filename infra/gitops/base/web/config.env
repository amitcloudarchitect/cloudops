# Identifiers only, read by the server at request time and handed to the browser
# (apps/web/src/lib/config.ts). The console has no secret to mount.
CLOUDOPS_WEB_API_BASE=SET-IN-OVERLAY
CLOUDOPS_WEB_ENTRA_CLIENT_ID=SET-IN-OVERLAY
CLOUDOPS_WEB_ENTRA_TENANT_ID=SET-IN-OVERLAY
CLOUDOPS_WEB_API_SCOPE=SET-IN-OVERLAY
# The platform's own monitoring (stack 03-observability outputs grafana_endpoint and
# app_insights_portal_url). Empty: the Observability page says "not yet applied".
CLOUDOPS_WEB_GRAFANA_URL=
CLOUDOPS_WEB_APP_INSIGHTS_URL=
