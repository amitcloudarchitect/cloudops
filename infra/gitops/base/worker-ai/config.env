CLOUDOPS_ENV=azure
CLOUDOPS_SECRETS_DIR=/mnt/secrets
CLOUDOPS_TEMPORAL_ADDRESS=temporal-frontend.temporal.svc.cluster.local:7233
CLOUDOPS_TEMPORAL_NAMESPACE=default
# The Certificate in worker-ai.yaml.
CLOUDOPS_TEMPORAL_TLS_DIR=/mnt/temporal-tls
# The Azure OpenAI account (ADR 0012), reached over its private endpoint with the
# workload identity's Entra token; not secret.
CLOUDOPS_AZURE_OPENAI_ENDPOINT=SET-IN-OVERLAY
