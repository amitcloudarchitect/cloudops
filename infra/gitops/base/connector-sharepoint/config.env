CLOUDOPS_ENV=azure
CLOUDOPS_SECRETS_DIR=/mnt/secrets
CLOUDOPS_TEMPORAL_ADDRESS=temporal-frontend.temporal.svc.cluster.local:7233
CLOUDOPS_TEMPORAL_NAMESPACE=default
# The Certificate in connector-sharepoint.yaml.
CLOUDOPS_TEMPORAL_TLS_DIR=/mnt/temporal-tls
# The connector's own bronze container (stack 04-data, connectors.tf).
CLOUDOPS_BRONZE_CONTAINER_URL=SET-IN-OVERLAY
CLOUDOPS_REPORTS_CONTAINER_URL=SET-IN-OVERLAY
# ADR 0028, not secret: app-cloudops-sharepoint's client id, and the folders granted
# to it, each <drive id>/<item id>, comma-separated.
CLOUDOPS_SHAREPOINT_CLIENT_ID=SET-IN-OVERLAY
CLOUDOPS_SHAREPOINT_FOLDERS=SET-IN-OVERLAY
# Telemetry (step 19, ADR 0022): OTLP to the in-cluster collector. The overlay names
# the deployment; dev may say CLOUDOPS_TELEMETRY=off until the collector runs there.
CLOUDOPS_TELEMETRY=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
CLOUDOPS_DEPLOYMENT=SET-IN-OVERLAY
